{
  "name": "jardim-de-luz-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run compile && vite",
    "build": "elm make src/Main.elm --optimize --output=public/elm.js && vite build",
    "preview": "vite preview",
    "format": "elm-format src tests --yes",
    "format:check": "elm-format src tests --validate",
    "test": "elm make tests/Checks.elm --output=elm-stuff/checks.js && node tests/run.cjs",
    "compile": "elm make src/Main.elm --output=public/elm.js"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "elm": "0.19.2-0",
    "elm-format": "^0.8.8",
    "vite": "^8.3.3"
  }
}
